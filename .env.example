# ContractAgent 环境变量模板：复制为 .env 并填入真实值（.env 不入库）

# 对话模型：硅基流动（OpenAI 兼容）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
CHAT_MODEL=deepseek-ai/DeepSeek-V4-flash #默认使用deepseek-ai/DeepSeek-V4-flash
CHAT_TEMPERATURE=0.5
CHAT_ENABLE_THINKING=false

# 向量模型：阿里 DashScope（OpenAI 兼容 embedding 端点）
# 旧键名 QWEN_EMBEDDING_API_KEY 同样被兼容读取
DASHSCOPE_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10

# 向量库 / 数据库
MILVUS_URI=http://127.0.0.1:19530
MILVUS_COLLECTION=contract_policies
DATABASE_URL=

# 检索后端：auto 表示 Milvus 不可用时自动退回内存检索
RETRIEVAL_BACKEND=auto
